NEXT_PUBLIC_SANITY_PROJECT_ID=pcb497o9
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-30

# Viewer-role token, created at manage.sanity.io → API → Tokens.
# Used server-side for the Live Content API and Draft Mode.
SANITY_API_READ_TOKEN=

# Resend API key, created at resend.com/api-keys. Powers /api/send-form
# (catering quote, contact, and query form submissions). Without it, form
# submissions are simulated locally (see src/app/api/send-form/route.ts).
RESEND_API_KEY=

# Optional — defaults to "Fatima Karahi <forms@fatimakarahiyeg.com>", which
# is verified in Resend (resend.com/domains). Only needed if that changes.
RESEND_FROM_EMAIL=

# Testing only — sends there instead of site.email. Not needed for normal
# use: once RESEND_FROM_EMAIL is on a verified domain, Resend can deliver to
# any recipient.
RESEND_TO_EMAIL=
